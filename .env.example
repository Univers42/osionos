# -----------------------------------------------------------------------------
# osionos app and bridge API
# Managed by apps/grobase/scripts/vault/vault-env.mjs.
# Copy to the matching .env file only for local development; Vault is the source of truth after seeding.
# -----------------------------------------------------------------------------

# REQUIRED: Required. The service will not boot, authenticate, or bridge correctly without these keys.
# Required. Secret used by osionos to sign local app sessions. If omitted: startup, auth, or bridge flow can fail.
OSIONOS_APP_SESSION_SECRET=replace-with-osionos-app-session-secret

# Required. Salt used to hash bridged email identities before persistence. If omitted: startup, auth, or bridge flow can fail.
OSIONOS_BRIDGE_EMAIL_HASH_SALT=replace-with-osionos-bridge-email-hash-salt

# Required. Shared secret used by the website auth gateway to request osionos bridge tokens. If omitted: startup, auth, or bridge flow can fail.
OSIONOS_BRIDGE_SHARED_SECRET=replace-with-osionos-bridge-shared-secret

# Required. Browser-exposed configuration. Never put private secrets in this key. If omitted: startup, auth, or bridge flow can fail.
VITE_API_URL=https://localhost:4000

# Required. Browser-exposed configuration. Never put private secrets in this key. If omitted: startup, auth, or bridge flow can fail.
VITE_PRISMATICA_URL=https://localhost:4322

# Required. Browser-exposed configuration. Never put private secrets in this key. If omitted: startup, auth, or bridge flow can fail.
VITE_REQUIRE_BRIDGE_SESSION=true

# RECOMMENDED: Recommended. Defaults keep local Docker usable, but set these to make routing, email, and integrations explicit.
# Recommended. Local port for Docker or development tooling. If omitted: Docker defaults are used, which is fine for local dev but less explicit for the team.
APP_PORT=3001

# Recommended. Origin accepted by the osionos bridge API. If omitted: Docker defaults are used, which is fine for local dev but less explicit for the team.
OSIONOS_ALLOWED_ORIGIN=https://localhost:3001

# Recommended. Browser-facing osionos app URL used in bridge redirects. If omitted: Docker defaults are used, which is fine for local dev but less explicit for the team.
OSIONOS_APP_URL=https://localhost:3001

# Recommended. osionos bridge/runtime setting. If omitted: Docker defaults are used, which is fine for local dev but less explicit for the team.
OSIONOS_BAAS_URL=http://kong:8000

# Recommended. osionos bridge/runtime setting. If omitted: Docker defaults are used, which is fine for local dev but less explicit for the team.
OSIONOS_BRIDGE_PERSISTENCE=auto

# Recommended. osionos bridge/runtime setting. If omitted: Docker defaults are used, which is fine for local dev but less explicit for the team.
OSIONOS_BRIDGE_PORT=4000

# Recommended. osionos bridge/runtime setting. If omitted: Docker defaults are used, which is fine for local dev but less explicit for the team.
OSIONOS_BRIDGE_REQUIRE_BAAS=false

# Recommended. Browser-exposed configuration. Never put private secrets in this key. If omitted: Docker defaults are used, which is fine for local dev but less explicit for the team.
VITE_PORT=3001

# OPTIONAL: Optional. Leave empty to disable the integration and gain a smaller local attack surface.
# Optional. Secret or token used for local authentication. If omitted: the related integration is disabled, reducing local secret sprawl.
DOCKER_PAT=

# Optional. Runtime configuration key for this service. If omitted: the related integration is disabled, reducing local secret sprawl.
DOCKER_USER=

# Optional. Secret or token used for local authentication. If omitted: the related integration is disabled, reducing local secret sprawl.
GITHUB_PAT=

# Optional. Runtime configuration key for this service. If omitted: the related integration is disabled, reducing local secret sprawl.
GITHUB_USER=

# Optional. MongoDB setting used by optional document/database adapters. If omitted: the related integration is disabled, reducing local secret sprawl.
MONGO_DB=

# Optional. MongoDB setting used by optional document/database adapters. If omitted: the related integration is disabled, reducing local secret sprawl.
MONGO_PASS=

# Optional. MongoDB setting used by optional document/database adapters. If omitted: the related integration is disabled, reducing local secret sprawl.
MONGO_PORT=3000

# Optional. MongoDB setting used by optional document/database adapters. If omitted: the related integration is disabled, reducing local secret sprawl.
MONGO_USER=

# Optional. Local port for Docker or development tooling. If omitted: the related integration is disabled, reducing local secret sprawl.
SONAR_PORT=3000

# Optional. Runtime configuration key for this service. If omitted: the related integration is disabled, reducing local secret sprawl.
SONAR_TOK=

# Optional. Secret or token used for local authentication. If omitted: the related integration is disabled, reducing local secret sprawl.
UNSPLASH_ACCESS_KEY=

# Optional. Browser-exposed configuration. Never put private secrets in this key. If omitted: the related integration is disabled, reducing local secret sprawl.
VITE_ALLOW_OFFLINE_MODE=

# Optional. Browser-exposed configuration. Never put private secrets in this key. If omitted: the related integration is disabled, reducing local secret sprawl.
VITE_BAAS_ANON_KEY=

# Optional. Browser-exposed configuration. Never put private secrets in this key. If omitted: the related integration is disabled, reducing local secret sprawl.
VITE_BAAS_ENABLED=false

# Optional. Browser-exposed configuration. Never put private secrets in this key. If omitted: the related integration is disabled, reducing local secret sprawl.
# Demo/dev JWT (HS256, stack JWT_SECRET) for the live-database realtime WebSocket (/realtime/v1/ws). Without it the live views fall back to 15s polling.
VITE_BAAS_REALTIME_TOKEN=

# Optional. Browser-exposed configuration. Never put private secrets in this key. If omitted: the related integration is disabled, reducing local secret sprawl.
VITE_BAAS_URL=http://localhost:3000
