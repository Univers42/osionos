# Playground environment variables
# Copy this to .env and customize as needed.

# Docker Hub release credentials used by `make tag VERSION=<tag>`.
# Never commit real credentials.
DOCKER_USER=
DOCKER_PAT=

# GitHub Container Registry release credentials used by `make tag VERSION=<tag>`.
GITHUB_USER=your-github-username
GITHUB_PAT=ghp_xxxxxxxxxxxx

MONGO_USER=osionos_user
MONGO_PASS=osionos_pass
MONGO_DB=playground_db
MONGO_PORT=27017

# Point this to the osionos bridge/API gateway. Leave empty to run offline.
VITE_API_URL=http://localhost:4000
VITE_REQUIRE_BRIDGE_SESSION=true
VITE_ALLOW_OFFLINE_MODE=false
VITE_PRISMATICA_URL=http://localhost:4322

# ── BaaS Connection ────────────────────────────────────────────────────────
# Flip VITE_BAAS_ENABLED=true when the Prismatica stack is running.
VITE_BAAS_ENABLED=false
VITE_BAAS_URL=http://localhost:8000
VITE_BAAS_ANON_KEY=eyJhbGciOiJIUzI1NiJ9...
# Never put BAAS_SERVICE_ROLE_KEY or JWT_SECRET in VITE_ vars.

# ── osionos bridge gateway (server-side only) ──────────────────────────────
# These values are read by scripts/bridge-api.mjs and Docker Compose services.
# Never prefix secrets with VITE_; Vite exposes VITE_* to browser code.
OSIONOS_BRIDGE_PORT=4000
OSIONOS_APP_URL=http://localhost:3001
OSIONOS_ALLOWED_ORIGIN=http://localhost:3001
OSIONOS_BAAS_URL=http://localhost:8000
OSIONOS_BRIDGE_PERSISTENCE=auto
OSIONOS_BRIDGE_REQUIRE_BAAS=false
# Server-side Unsplash API access key used by /api/media/unsplash/search.
# Do not prefix this with VITE_; the bridge reads it from Node process env.
UNSPLASH_ACCESS_KEY=
# Generated locally by ../../infrastructure/baas/scripts/ensure-osionos-runtime-secrets.mjs.
OSIONOS_BRIDGE_SHARED_SECRET=
OSIONOS_APP_SESSION_SECRET=
OSIONOS_BRIDGE_EMAIL_HASH_SALT=

# ── Shared MongoDB (Phase 3) ───────────────────────────────────────────────
# MONGO_URI=mongodb://osionos_user:osionos_pass@prismatica_mongodb:27017/playground_db?authSource=admin
# Comment out the mongodb service in docker-compose.base.yml when set.

VITE_PORT=3001
APP_PORT=80
SONAR_PORT=9000
