{
  "name": "osionos-playground",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "bash scripts/docker-dev.sh",
    "dev:local": "vite",
    "build": "bash scripts/docker-run.sh build",
    "build:local": "tsc --noEmit && vite build",
    "preview": "bash scripts/docker-run.sh preview",
    "preview:local": "vite preview --host 0.0.0.0",
    "typecheck": "bash scripts/docker-run.sh typecheck",
    "typecheck:local": "tsc --noEmit",
    "lint": "bash scripts/docker-run.sh lint",
    "lint:local": "eslint src/ --max-warnings=0",
    "lint:fix": "bash scripts/docker-run.sh lint-fix",
    "lint:fix:local": "eslint src/ --fix",
    "test": "pnpm run test:e2e",
    "test:e2e": "bash scripts/docker-run.sh test-e2e",
    "test:e2e:local": "playwright test",
    "test:e2e:serial": "bash scripts/docker-run.sh test-e2e-serial",
    "test:e2e:serial:local": "playwright test --workers=1",
    "test:e2e:smoke": "bash scripts/docker-run.sh test-e2e-smoke",
    "test:e2e:smoke:local": "playwright test tests/e2e/smoke",
    "test:doctor": "bash scripts/docker-run.sh test-doctor",
    "test:doctor:local": "node tests/test-env-doctor.mjs",
    "test:quality": "pnpm run typecheck && pnpm run lint",
    "test:setup": "pnpm run test:doctor"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@univers42/ui-collection": "^2.5.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.45",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "mermaid": "^11.14.0",
    "motion": "^12.38.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.1.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "playwright": "^1.59.1",
    "sass-embedded": "^1.99.0",
    "tailwindcss": "^4.1.3",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.58.1",
    "vite": "^6.2.0"
  }
}
