static const t_dev g_me = {
    .name       = "Dylan Lesieur",
    .school     = "42 School",
    .focus      = "Systems / Memory / Concurrency",
    .currently  = "ft_transcendence (NestJS + React)",
    .philosophy = "If it passes Valgrind, you understood it.",
