{
  "name": "@osionos/ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Shared React component kit: atoms, primitives, molecules and hooks, themed entirely through --osio-* custom properties so the host owns the palette. Ships no CSS of its own and no runtime dependencies — every library it uses is a peer.",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./tokens.css",
    "./*": "./src/*"
  },
  "peerDependencies": {
    "@tanstack/react-virtual": "^3.0.0",
    "@univers42/ui-collection": "*",
    "highlight.js": "^11.0.0",
    "lucide-react": ">=0.400.0",
    "mermaid": "^11.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-virtual": {
      "optional": true
    },
    "highlight.js": {
      "optional": true
    },
    "mermaid": {
      "optional": true
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run check:tokens",
    "check:tokens": "node scripts/check-token-contract.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  }
}
