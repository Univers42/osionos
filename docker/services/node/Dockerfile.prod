# syntax=docker/dockerfile:1.7

FROM public.ecr.aws/docker/library/node:22-alpine AS builder

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH

WORKDIR /app

RUN corepack enable \
  && corepack prepare pnpm@10.32.1 --activate \
  && mkdir -p /pnpm/store \
  && pnpm config set store-dir /pnpm/store

COPY package.json pnpm-lock.yaml ./
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
  pnpm install --frozen-lockfile

COPY index.html tsconfig.json vite.config.ts eslint.config.js ./
COPY src ./src
COPY packages ./packages
COPY public ./public
COPY config ./config

ARG VITE_API_URL=""
ARG VITE_APP_VERSION="dev"
ARG VITE_BAAS_ENABLED="false"
ARG VITE_BAAS_URL=""
ARG VITE_BAAS_ANON_KEY=""
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_APP_VERSION=$VITE_APP_VERSION
ENV VITE_BAAS_ENABLED=$VITE_BAAS_ENABLED
ENV VITE_BAAS_URL=$VITE_BAAS_URL
ENV VITE_BAAS_ANON_KEY=$VITE_BAAS_ANON_KEY

# Build, then strip source maps from the shipped image (they tripled its size
# and leak source) and precompress static assets so nginx's gzip_static
# serves them with zero CPU per request.
# Invoke vite directly (not `pnpm run build`, which shells out to
# bash scripts/docker-run.sh — bash is absent in node:alpine). Type-checking
# is the CI `quality` job's responsibility; the image only needs the bundle.
RUN pnpm exec vite build \
 && find build -name '*.map' -delete \
 && find build -type f \( -name '*.js' -o -name '*.css' -o -name '*.svg' \
      -o -name '*.json' -o -name '*.wasm' \) -size +1k -print0 \
    | xargs -0 -P "$(nproc)" -n 16 gzip -9k

FROM public.ecr.aws/docker/library/nginx:1.27-alpine AS runtime

LABEL org.opencontainers.image.title="osionos"
LABEL org.opencontainers.image.description="Notion-inspired workspace — Univers42"
LABEL org.opencontainers.image.source="https://github.com/univers42/osionos"
LABEL maintainer="dlesieur@student.42.fr"

COPY docker/services/node/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/build /usr/share/nginx/html
COPY --from=builder /app/config /app/config

RUN addgroup -S osionos && adduser -S osionos -G osionos \
  && chown -R osionos:osionos /usr/share/nginx/html \
  && chmod -R 755 /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --retries=3 --start-period=5s \
  CMD wget -qO- http://127.0.0.1/ >/dev/null || exit 1